/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "mt7981-QLB-4pro";
	compatible = "mediatek,mt7981", "mediatek,mt7981-rfb";

	chosen {
		stdout-path = &uart0;
		tick-timer = &timer0;
	};
	mtd-layout {
		layout@0 {
			label = "default";
			cmdline = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x11002000";
			mtdids = "nmbm0=nmbm0";
			mtdparts = "nmbm0:1024k(bl2),512k(u-boot-env),2048k(Factory),2048k(fip),1024k(Config),58112k(ubi),58112k(ubi1)";			
		};

		layout@1 {
			label = "ubi-107m";
			mtdids = "nmbm0=nmbm0";
			mtdparts = "nmbm0:1024k(bl2),512k(u-boot-env),2048k(Factory),2048k(fip),116736k(ubi)";
		};
	};
	config {
		bootcmd = "mtkboardboot";
		blink_led = "white:internet";
		system_led = "white:wps";
	};


pwm-leds {
    compatible = "pwm-leds";
    
    led-0 {
        label = "white:wan";
        /* 
         * pwms 格式: <&pwm_controller channel period_ns polarity>
         * &pwm0: 引用 PWM 控制器节点
         * 0: 通道号
         * 1000000: 周期为 1,000,000 纳秒 (即 1kHz 频率)
         * PWM_POLARITY_NORMAL: 正常极性 (高电平有效)
         */
        pwms = <&pwm0 0 1000000 PWM_POLARITY_NORMAL>;
        max-brightness = <255>; /* 可选：最大亮度值 */
    };

    led-1 {
        label = "white:internet";
        pwms = <&pwm0 1 1000000 PWM_POLARITY_NORMAL>;
        max-brightness = <255>;
    };

    led-2 {
        label = "white:wps";
        /* 假设 WPS 使用另一个 PWM 控制器 pwm1 */
        pwms = <&pwm1 0 1000000 PWM_POLARITY_NORMAL>;
        max-brightness = <255>;
    };
};



	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x20000000>;
	};

	bl2_verify {
		bl2_compatible = "spim-nand";
	};
};

&uart0 {
	status = "okay";
};

&eth {
	status = "okay";
	mediatek,gmac-id = <0>;
	phy-mode = "2500base-x";
	mediatek,switch = "auto";
	reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&pio {
	spi_flash_pins: spi0-pins-func-1 {
		mux {
			function = "flash";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
		};

		conf-pd {
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
		};
	};
};

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi_flash_pins>;
	status = "okay";
	must_tx;
	enhance_timing;
	dma_ext;
	ipm_design;
	support_quad;
	tick_dly = <2>;
	sample_sel = <0>;

	spi_nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
	};
};

&pwm0 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pwm0_pins>; /* 确保引脚复用为 PWM 功能 */
};

&watchdog {
	status = "disabled";
};
